:root{--bg:#0a0a0c;--panel:#111216;--red:#e10600;--text:#f5f5f3;--muted:#999ba3;--line:rgba(255,255,255,.11);--display:'Orbitron',sans-serif;--body:'Inter',sans-serif}*{box-sizing:border-box}html{scroll-behavior:auto}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--body);overflow-x:hidden}a{text-decoration:none;color:inherit}button,input,textarea,select{font:inherit}.app{min-height:100vh;background:radial-gradient(circle at 75% 15%,rgba(225,6,0,.09),transparent 24%),radial-gradient(circle at 15% 45%,rgba(255,255,255,.025),transparent 25%)}.grain{position:fixed;inset:0;pointer-events:none;opacity:.055;z-index:100;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E")}.loader{position:fixed;inset:0;background:#050506;z-index:999;display:grid;place-content:center;padding:30px}.loader-mark{text-align:center;font-family:var(--display);font-size:70px;font-weight:800;letter-spacing:-8px;position:relative}.loader-mark span{background:linear-gradient(90deg,#fff,#e10600,#aaa);-webkit-background-clip:text;color:transparent}.loader-mark i{position:absolute;left:-20%;right:-20%;top:50%;height:2px;background:#fff;box-shadow:0 0 20px #e10600;animation:sweep .8s ease-in-out infinite alternate}.loader-meta{display:flex;justify-content:space-between;color:#777;font-size:10px;letter-spacing:2px;margin-top:28px}.rev{height:3px;background:#18191d;margin-top:10px;width:min(400px,70vw);overflow:hidden}.rev div{height:100%;background:var(--red);box-shadow:0 0 14px var(--red)}.loader p{text-align:center;color:#555;font-size:9px;letter-spacing:4px;margin-top:15px}@keyframes sweep{from{transform:translateX(-30%)}to{transform:translateX(30%)}}.nav{position:fixed;top:0;left:0;right:0;height:84px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;z-index:90;background:linear-gradient(180deg,rgba(10,10,12,.9),transparent);backdrop-filter:blur(4px)}.brand{display:flex;align-items:center;gap:12px}.brand-mm{font-family:var(--display);font-weight:900;font-size:27px;letter-spacing:-4px;color:#fff;text-shadow:0 0 18px rgba(225,6,0,.45)}.brand b{font-family:var(--display);font-size:12px;letter-spacing:2px}.brand small{display:block;color:#74757a;font-size:7px;letter-spacing:1.2px;margin-top:4px}.nav nav{display:flex;align-items:center;gap:28px}.nav nav>a:not(.nav-cta){font-size:11px;color:#aaa;letter-spacing:1px;transition:.3s}.nav nav>a:not(.nav-cta):hover{color:#fff}.nav-cta{display:flex;align-items:center;gap:8px;border:1px solid var(--line);padding:12px 15px;font-size:9px;letter-spacing:1.2px;background:rgba(255,255,255,.03)}.menu{display:none;background:none;border:0;color:#fff}.hero{min-height:100vh;position:relative;display:flex;align-items:center;padding:100px 5vw 50px;overflow:hidden}.hero:before{content:'';position:absolute;width:60vw;height:60vw;border-radius:50%;right:-15%;top:5%;background:radial-gradient(circle,rgba(225,6,0,.16),transparent 62%);filter:blur(20px)}.hero-copy{position:relative;z-index:3;width:48%;max-width:720px}.eyebrow,.section-tag{font-size:9px;letter-spacing:2.8px;color:#888;text-transform:uppercase}.eyebrow span{display:inline-block;width:32px;height:1px;background:var(--red);vertical-align:middle;margin-right:10px}.hero h1,h2{font-family:var(--display);font-weight:700;letter-spacing:-2px;line-height:.98;margin:18px 0;font-size:clamp(45px,6.8vw,100px)}h1 em,h2 em{font-style:normal;color:transparent;-webkit-text-stroke:1px #777;text-shadow:0 0 30px rgba(225,6,0,.08)}.lead{font-family:var(--display);font-size:14px;letter-spacing:3px;color:#ddd}.sublead{color:#8d8e95;max-width:450px;line-height:1.8;font-size:14px}.actions{display:flex;gap:12px;margin-top:32px}.magnetic{transform:translate(var(--mx,0),var(--my,0));transition:transform .25s ease}.btn{display:inline-flex;align-items:center;gap:10px;padding:15px 20px;font-size:10px;letter-spacing:1.5px;font-weight:700}.btn-red{background:var(--red);box-shadow:0 0 35px rgba(225,6,0,.2)}.btn-ghost{border:1px solid var(--line);background:rgba(255,255,255,.02)}.car-stage{position:absolute;right:-3%;top:12%;width:62%;height:78%;z-index:2}.stage-label{position:absolute;right:8%;bottom:12%;display:flex;gap:30px;font-size:9px;letter-spacing:2px;color:#666}.stage-label b{color:var(--red)}.model-loading{font-size:10px;letter-spacing:2px;color:#777}.hero-bottom{position:absolute;bottom:35px;left:5vw;display:flex;align-items:center;gap:15px;color:#666;font-size:8px;letter-spacing:2px}.scroll-line{width:60px;height:1px;background:#555}.section{padding:130px 5vw;position:relative}.about{border-top:1px solid var(--line)}.about-grid,.why-grid,.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:10vw;margin-top:35px}.about h2,.why h2,.booking h2,.contact h2{font-size:clamp(42px,5.4vw,82px)}.about-copy{padding-top:30px;max-width:520px}.about-copy p{line-height:1.9;color:#aaa;font-size:15px}.muted{color:#666!important;font-family:var(--display);font-size:11px!important;letter-spacing:1px}.text-link{display:inline-flex;align-items:center;gap:9px;font-size:10px;letter-spacing:1.6px;margin-top:20px;border-bottom:1px solid #444;padding-bottom:8px}.counters{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:90px;border-top:1px solid var(--line);padding-top:30px}.counter strong{display:block;font-family:var(--display);font-size:clamp(28px,4vw,55px)}.counter span{display:block;color:#666;font-size:9px;letter-spacing:1.5px;margin-top:8px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:45px}.section-head h2{font-size:clamp(42px,5vw,72px);margin-bottom:0}.section-head>p{max-width:390px;color:#777;font-size:13px;line-height:1.7}.service-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;perspective:1200px}.service-card{min-height:340px;background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.012));border:1px solid var(--line);padding:25px;position:relative;overflow:hidden;transform-style:preserve-3d}.service-card:after{content:'';position:absolute;inset:auto -20% -30% -20%;height:60%;background:radial-gradient(circle,rgba(225,6,0,.18),transparent 60%);opacity:.4}.card-no{position:absolute;right:18px;top:17px;font-family:var(--display);font-size:9px;color:#555}.service-icon{font-size:40px;color:var(--red);margin:25px 0 50px;text-shadow:0 0 25px rgba(225,6,0,.35)}.service-card>span{font-size:8px;letter-spacing:2px;color:#777}.service-card h3{font-family:var(--display);font-size:17px;line-height:1.3;margin:10px 0}.service-card p{font-size:11px;color:#777;line-height:1.7}.card-arrow{position:absolute;right:20px;bottom:20px;color:#666}.arrival{min-height:680px;display:flex;align-items:center;overflow:hidden}.arrival-image{position:absolute;inset:0}.arrival-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) contrast(1.1)}.image-overlay{position:absolute;inset:0;background:linear-gradient(90deg,#0a0a0c 4%,rgba(10,10,12,.68) 45%,rgba(10,10,12,.25)),linear-gradient(0deg,#0a0a0c,transparent 35%)}.arrival-copy{position:relative;z-index:2;max-width:570px}.arrival-copy h2{font-size:clamp(45px,6vw,90px)}.arrival-copy p{color:#bbb;line-height:1.8;max-width:440px}.gallery-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:110px;gap:10px}.gallery-item{border:0;padding:0;background:#111;position:relative;overflow:hidden;cursor:pointer}.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .5s}.gallery-item:hover img{transform:scale(1.08);filter:brightness(.75)}.gallery-item span{position:absolute;left:15px;right:15px;bottom:15px;display:flex;justify-content:space-between;font-size:9px;letter-spacing:1.4px;text-transform:uppercase;text-align:left}.g1{grid-column:span 7;grid-row:span 4}.g2{grid-column:span 5;grid-row:span 2}.g3{grid-column:span 5;grid-row:span 2}.g4{grid-column:span 4;grid-row:span 3}.g5{grid-column:span 4;grid-row:span 3}.g6{grid-column:span 4;grid-row:span 3}.why{background:linear-gradient(180deg,transparent,rgba(255,255,255,.018),transparent)}.why-list{border-top:1px solid var(--line)}.why-row{display:grid;grid-template-columns:35px 35px 1fr;gap:15px;padding:24px 0;border-bottom:1px solid var(--line);align-items:start}.why-row>b{font-size:9px;color:#555}.why-row svg{color:var(--red)}.why-row h3{font-family:var(--display);font-size:13px;letter-spacing:1px;margin:0}.why-row p{font-size:11px;line-height:1.7;color:#777;margin:9px 0 0}.carousel-controls{display:flex;gap:7px}.carousel-controls button{width:42px;height:42px;background:#15161a;border:1px solid var(--line);color:#fff}.quote-stage{max-width:850px;margin:auto}.quote-card{background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.015));border:1px solid var(--line);padding:55px;min-height:300px;display:flex;flex-direction:column;justify-content:space-between}.quote-card>svg{color:var(--red)}blockquote{font-family:var(--display);font-size:clamp(20px,2.8vw,34px);line-height:1.5;margin:20px 0}.quote-card div{display:flex;gap:15px;align-items:center}.quote-card div b{font-size:10px;letter-spacing:1px}.quote-card div span{color:#666;font-size:9px}.before-after{padding-top:80px}.ba-wrap{height:600px;position:relative;overflow:hidden;background:#151515}.ba-wrap>img,.ba-before img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ba-wrap>img{filter:saturate(.8)}.ba-before{position:absolute;inset:0;overflow:hidden}.ba-before img{width:100vw;max-width:none}.ba-wrap input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize}.ba-handle{position:absolute;top:0;bottom:0;width:2px;background:#fff;box-shadow:0 0 20px #000;transform:translateX(-50%);pointer-events:none}.ba-handle span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-weight:700}.ba-label{position:absolute;top:20px;font-size:8px;letter-spacing:2px;padding:8px;background:rgba(0,0,0,.5)}.before-label{left:20px}.after-label{right:20px}.booking{display:grid;grid-template-columns:.8fr 1.2fr;gap:10vw;background:#0d0e11}.booking-intro p{max-width:400px;color:#888;line-height:1.8}.whatsapp{display:inline-flex;align-items:center;gap:9px;margin-top:25px;border:1px solid rgba(37,211,102,.35);padding:13px 15px;color:#b9e8c8;font-size:9px;letter-spacing:1.5px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.booking-form label{display:flex;flex-direction:column;gap:8px;color:#666;font-size:9px;letter-spacing:1.4px;margin-bottom:15px}.booking-form input,.booking-form select,.booking-form textarea{border:1px solid var(--line);background:#111216;color:#eee;padding:14px;outline:0;border-radius:0}.booking-form input:focus,.booking-form select:focus,.booking-form textarea:focus{border-color:rgba(225,6,0,.7)}.booking-form textarea{resize:vertical}.submit{border:0;background:var(--red);color:#fff;padding:17px 20px;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;font-weight:700;font-size:10px;letter-spacing:1.5px}.contact-grid{align-items:stretch}.contact-items{margin-top:40px}.contact-items p{display:flex;gap:15px;border-bottom:1px solid var(--line);padding:18px 0}.contact-items svg{color:var(--red);flex:none}.contact-items b{display:block;font-size:11px}.contact-items small{display:block;color:#666;font-size:9px;margin-top:5px}.socials{display:flex;gap:10px;margin-top:25px}.socials a{border:1px solid var(--line);padding:11px 13px;display:flex;gap:8px;align-items:center;font-size:9px;letter-spacing:1px}.map-card{min-height:510px;background:#111;position:relative;border:1px solid var(--line);overflow:hidden}.map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:50px 50px;transform:perspective(500px) rotateX(35deg) scale(1.4);transform-origin:center bottom;opacity:.35}.map-pin{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center}.map-pin svg{color:var(--red);filter:drop-shadow(0 0 18px rgba(225,6,0,.8))}.map-pin span{display:block;font-family:var(--display);font-size:10px;letter-spacing:1px;margin-top:10px}.map-pin small{color:#777;font-size:7px}.map-note{position:absolute;bottom:20px;left:20px;color:#555;font-size:8px;letter-spacing:1px}footer{border-top:1px solid var(--line);padding:35px 5vw;display:flex;align-items:center;justify-content:space-between;gap:25px;color:#666;font-size:9px}.footer-brand{display:flex;gap:12px;align-items:center}.footer-brand b{font-family:var(--display);font-size:10px;color:#ddd;letter-spacing:1px}.footer-brand small{display:block;font-size:7px;letter-spacing:1px;margin-top:5px}.footer-links{display:flex;gap:20px}.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:300;display:grid;place-items:center;padding:5vw}.lightbox img{max-width:90vw;max-height:85vh}.lightbox button{position:absolute;top:30px;right:30px;background:none;border:0;color:#fff}.reveal{will-change:transform,opacity}
@media(max-width:1050px){.service-grid{grid-template-columns:repeat(2,1fr)}.service-card{min-height:290px}.car-stage{width:65%;opacity:.8}.hero-copy{width:58%}.nav nav{gap:16px}.nav nav>a:not(.nav-cta){display:none}.menu{display:block}.nav nav{position:fixed;top:70px;right:20px;display:none;background:#111216;border:1px solid var(--line);padding:15px;flex-direction:column;align-items:stretch;min-width:210px}.nav nav.open{display:flex}.nav nav.open>a:not(.nav-cta){display:block;padding:10px}}
@media(max-width:700px){.nav{height:70px;padding:0 20px}.brand small{display:none}.hero{min-height:850px;padding:120px 20px 50px;align-items:flex-start}.hero-copy{width:100%}.hero h1{font-size:48px}.sublead{max-width:330px}.actions{flex-wrap:wrap}.car-stage{top:35%;right:-30%;width:130%;height:60%;opacity:.9}.hero-bottom{left:20px}.section{padding:90px 20px}.about-grid,.why-grid,.contact-grid,.booking{grid-template-columns:1fr;gap:50px}.about-copy{padding-top:0}.counters{grid-template-columns:1fr 1fr;gap:30px;margin-top:55px}.section-head{display:block}.section-head>p{margin-top:20px}.service-grid{grid-template-columns:1fr}.service-card{min-height:310px}.arrival{min-height:680px;padding:90px 20px}.arrival-copy{align-self:end}.gallery-grid{grid-template-columns:1fr 1fr;grid-auto-rows:170px}.g1,.g2,.g3,.g4,.g5,.g6{grid-column:span 1;grid-row:span 1}.g1{grid-column:span 2;grid-row:span 2}.ba-wrap{height:390px}.form-grid{grid-template-columns:1fr}.quote-card{padding:30px;min-height:340px}.map-card{min-height:360px}footer{flex-direction:column;align-items:flex-start}.footer-links{flex-wrap:wrap}.brand-mm{font-size:23px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}.loader{display:none}.reveal{opacity:1!important;transform:none!important}}
