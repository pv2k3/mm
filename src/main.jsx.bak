import React, { Suspense, useEffect, useRef, useState } from 'react';
import { createRoot } from 'react-dom/client';
import * as THREE from 'three';
import { Canvas, useFrame } from '@react-three/fiber';
import { Environment, Float, Html, OrbitControls, useGLTF, ContactShadows } from '@react-three/drei';
import { motion, AnimatePresence } from 'framer-motion';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import Lenis from 'lenis';
import { ArrowDownRight, ArrowUpRight, CalendarDays, CarFront, CheckCircle2, ChevronLeft, ChevronRight, Clock3, Instagram, MapPin, Menu, MessageCircle, Phone, Play, ShieldCheck, Sparkles, Star, Wrench, X, Youtube, Zap } from 'lucide-react';
import './styles.css';

gsap.registerPlugin(ScrollTrigger);

const BRAND = { whatsapp: '919999999999', phone: '+91 99999 99999', instagram: 'https://instagram.com/mm.motors.official', youtube: 'https://youtube.com/@mm.motors' };
const services = [
  { title:'Denting & Painting', kicker:'RESTORE', icon:'✦', copy:'Panel correction, precision paint matching and finish restoration for a factory-fresh look.' },
  { title:'Complete Car Servicing', kicker:'MAINTAIN', icon:'⌁', copy:'Periodic maintenance, diagnostics, fluids, filters and preventive checks under one roof.' },
  { title:'Car Washing & Detailing', kicker:'REFINE', icon:'◈', copy:'Deep cleaning, paint correction and detailing treatments that make every surface count.' },
  { title:'Repairs & Modifications', kicker:'UPGRADE', icon:'↗', copy:'Mechanical repairs, performance upgrades and tasteful modifications engineered for the road.' },
  { title:'Buy / Sell / Exchange', kicker:'MOVE', icon:'↔', copy:'Explore old and second-hand cars with a transparent, workshop-backed approach.' }
];
const testimonials = [
  ['“The finish was genuinely showroom-level. The team explained every step instead of just handing me a bill.”','Aarav S.','BMW 3 Series'],
  ['“Dropped the car for service and detailing. The turnaround was quick and the communication was excellent.”','Riya M.','Hyundai Creta'],
  ['“From diagnosis to the final delivery, MM Motors felt premium without feeling intimidating.”','Kunal V.','Skoda Octavia']
];
const gallery = [
  ['Workshop / Hero','https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1200&q=85'],
  ['Detailing','https://images.unsplash.com/photo-1607860108855-64acf2078ed9?auto=format&fit=crop&w=1000&q=85'],
  ['Performance','https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1000&q=85'],
  ['Paint Finish','https://images.unsplash.com/photo-1553440569-bcc63803a83d?auto=format&fit=crop&w=1000&q=85'],
  ['Workshop','https://images.unsplash.com/photo-1487754180451-c456f719a1fc?auto=format&fit=crop&w=1000&q=85'],
  ['Night Drive','https://images.unsplash.com/photo-1542282088-fe8426682b8f?auto=format&fit=crop&w=1000&q=85']
];

function Loader({onDone}){
  const [progress,setProgress]=useState(0);
  useEffect(()=>{ const t=setInterval(()=>setProgress(p=>Math.min(100,p+4)),32); const done=setTimeout(onDone,1100); return()=>{clearInterval(t);clearTimeout(done)}},[onDone]);
  return <AnimatePresence><motion.div className="loader" initial={{opacity:1}} exit={{opacity:0}}><div className="loader-mark"><span>MM</span><i/></div><div className="loader-meta"><span>MM MOTORS / LUCKNOW</span><span>{String(progress).padStart(3,'0')}%</span></div><div className="rev"><div style={{width:`${progress}%`}}/></div><p>INITIALIZING PERFORMANCE</p></motion.div></AnimatePresence>
}

function ProceduralCar(){
  const group=useRef();
  useFrame((state,delta)=>{ if(group.current){ group.current.rotation.y += delta*0.16; group.current.position.y = Math.sin(state.clock.elapsedTime*.8)*.035; }});
  return <group ref={group} rotation={[0,.25,0]} scale={1.5}>
    <mesh castShadow receiveShadow position={[0,.25,0]}><boxGeometry args={[3.7,.55,1.5]} /><meshStandardMaterial color="#15171b" metalness={.85} roughness={.2}/></mesh>
    <mesh castShadow position={[.15,.62,0]} rotation={[0,0,-.02]}><boxGeometry args={[1.95,.5,1.25]} /><meshStandardMaterial color="#090a0c" metalness={.4} roughness={.16}/></mesh>
    <mesh position={[1.85,.27,0]}><boxGeometry args={[.18,.13,1.15]} /><meshStandardMaterial color="#e10600" emissive="#e10600" emissiveIntensity={3}/></mesh>
    {[-1.25,1.25].map(x=><group key={x}><mesh position={[x,-.08,.78]} rotation={[Math.PI/2,0,0]}><cylinderGeometry args={[.38,.38,.22,32]} /><meshStandardMaterial color="#050507" metalness={.9} roughness={.18}/></mesh><mesh position={[x,-.08,-.78]} rotation={[Math.PI/2,0,0]}><cylinderGeometry args={[.38,.38,.22,32]} /><meshStandardMaterial color="#050507" metalness={.9} roughness={.18}/></mesh></group>)}
    <mesh position={[.2,.63,.01]}><boxGeometry args={[1.5,.36,1.1]} /><meshStandardMaterial color="#05070a" transparent opacity={.72} metalness={.15} roughness={.05}/></mesh>
  </group>
}
function HeroCar(){
  const [hasModel,setHasModel]=useState(true);
  return <Canvas shadows dpr={[1,1.5]} camera={{position:[4.8,2.2,5.6],fov:34}} gl={{antialias:true,alpha:true}}>
    <ambientLight intensity={.35}/><spotLight position={[3,5,2]} intensity={100} angle={.35} penumbra={1} color="#ffffff" castShadow/><spotLight position={[-4,2,-3]} intensity={80} angle={.5} penumbra={1} color="#e10600"/><pointLight position={[0,1,3]} intensity={15} color="#e10600"/>
    <Suspense fallback={<Html center><div className="model-loading">LOADING 3D / <b>MM</b></div></Html>}><ProceduralCar/></Suspense>
    <ContactShadows position={[0,-.5,0]} opacity={.65} scale={8} blur={2.5} far={5}/><Environment preset="city" environmentIntensity={.35}/>
    <OrbitControls enablePan={false} enableZoom={false} minPolarAngle={Math.PI/2.7} maxPolarAngle={Math.PI/2.05}/>
  </Canvas>
}

function Magnetic({children, className='', href}){ return <a className={`magnetic ${className}`} href={href||'#'} onMouseMove={e=>{const r=e.currentTarget.getBoundingClientRect(); e.currentTarget.style.setProperty('--mx',`${(e.clientX-r.left-r.width/2)*.15}px`);e.currentTarget.style.setProperty('--my',`${(e.clientY-r.top-r.height/2)*.15}px`)}} onMouseLeave={e=>{e.currentTarget.style.setProperty('--mx','0px');e.currentTarget.style.setProperty('--my','0px')}}>{children}</a> }
function Counter({value,label}){ const [n,setN]=useState(0); const ref=useRef(); useEffect(()=>{const obs=new IntersectionObserver(([e])=>{if(e.isIntersecting){let s=0;const id=setInterval(()=>{s+=Math.ceil(value/28);if(s>=value){s=value;clearInterval(id)}setN(s)},35);obs.disconnect()}},{threshold:.6});obs.observe(ref.current);return()=>obs.disconnect()},[value]); return <div ref={ref} className="counter"><strong>{n}{value>99?'+':''}</strong><span>{label}</span></div> }
function App(){
  const [loaded,setLoaded]=useState(false); const [menu,setMenu]=useState(false); const [lightbox,setLightbox]=useState(null); const [slide,setSlide]=useState(0); const [before,setBefore]=useState(54);
  useEffect(()=>{ const lenis=new Lenis({duration:1.15,smoothWheel:true}); function raf(t){lenis.raf(t);requestAnimationFrame(raf)} requestAnimationFrame(raf); const ctx=gsap.context(()=>{gsap.utils.toArray('.reveal').forEach(el=>gsap.fromTo(el,{y:70,opacity:0},{y:0,opacity:1,duration:1,stagger:.06,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 84%'}})); gsap.to('.hero-copy',{y:-100,opacity:.15,scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}}); gsap.to('.car-stage',{y:-80,scale:1.06,scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});},document); return()=>{lenis.destroy();ctx.revert()}},[]);
  const submit=e=>{e.preventDefault(); alert('Thanks — your service request is ready. Connect WhatsApp to confirm your slot.');};
  return <div className="app">{!loaded&&<Loader onDone={()=>setLoaded(true)}/>}<div className="grain"/><header className="nav"><a href="#home" className="brand"><span className="brand-mm">MM</span><span><b>MM MOTORS</b><small>DRIVEN BY PASSION, BUILT TO PERFORM.</small></span></a><nav className={menu?'open':''}>{['About','Services','Gallery','Why Us','Contact'].map(x=><a key={x} href={'#'+x.toLowerCase().replace(' ','-')} onClick={()=>setMenu(false)}>{x}</a>)}<Magnetic href="#booking" className="nav-cta">BOOK A SERVICE <ArrowUpRight size={15}/></Magnetic></nav><button className="menu" onClick={()=>setMenu(!menu)}>{menu?<X/>:<Menu/>}</button></header>
  <main>
    <section id="home" className="hero"><div className="hero-copy"><p className="eyebrow"><span/> LUCKNOW / AUTOMOTIVE STUDIO</p><h1>BUILT FOR<br/><em>YOUR DRIVE.</em></h1><p className="lead">Repair • Modify • Upgrade</p><p className="sublead">Precision service. Bold modifications. A workshop experience designed around the way you drive.</p><div className="actions"><Magnetic href="#booking" className="btn btn-red">BOOK A SERVICE <ArrowUpRight size={17}/></Magnetic><Magnetic href="#services" className="btn btn-ghost">EXPLORE SERVICES <ArrowDownRight size={17}/></Magnetic></div></div><div className="car-stage"><HeroCar/><div className="stage-label"><span>MM / PERFORMANCE</span><b>01</b></div></div><div className="hero-bottom"><span>SCROLL TO EXPLORE</span><div className="scroll-line"/></div></section>
    <section id="about" className="section about"><div className="section-tag reveal">01 / THE MM STANDARD</div><div className="about-grid"><div className="reveal"><h2>Same Trust.<br/><em>Bigger Space.</em><br/>Better Facilities.</h2></div><div className="about-copy reveal"><p>MM Motors is built for drivers who care about what happens after they hand over the keys. From everyday servicing to serious upgrades, every job gets the same obsession with detail.</p><p className="muted">Driven by passion, built to perform.</p><a href="#contact" className="text-link">MEET THE WORKSHOP <ArrowUpRight size={16}/></a></div></div><div className="counters"><Counter value={2500} label="Cars serviced"/><Counter value={1800} label="Happy customers"/><Counter value={8} label="Years experience"/><Counter value={2} label="Branches"/></div></section>
    <section id="services" className="section services"><div className="section-head reveal"><div><div className="section-tag">02 / WHAT WE DO</div><h2>Built to <em>move.</em></h2></div><p>From paint correction to performance modifications, we keep the process clear and the finish uncompromising.</p></div><div className="service-grid">{services.map((s,i)=><motion.article whileHover={{y:-10,rotateX:2,rotateY:i%2?2:-2}} transition={{type:'spring',stiffness:220,damping:18}} className="service-card reveal" key={s.title}><div className="card-no">0{i+1}</div><div className="service-icon">{s.icon}</div><span>{s.kicker}</span><h3>{s.title}</h3><p>{s.copy}</p><ArrowUpRight className="card-arrow"/></motion.article>)}</div></section>
    <section className="arrival section"><div className="arrival-image"><img src="https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1800&q=88" alt="Premium automotive workshop placeholder"/><div className="image-overlay"/></div><div className="arrival-copy reveal"><div className="section-tag">03 / NEW BRANCH ARRIVAL</div><h2>A new home<br/>for <em>serious cars.</em></h2><p>More space. Better equipment. The same MM Motors standard — now closer to the road you take every day.</p><Magnetic href="#contact" className="btn btn-red">VISIT US <MapPin size={16}/></Magnetic></div></section>
    <section id="gallery" className="section gallery"><div className="section-head reveal"><div><div className="section-tag">04 / THE WORK</div><h2>See the <em>difference.</em></h2></div><p>Placeholder media is ready to be replaced with your actual MM Motors reels, workshop shots and customer cars.</p></div><div className="gallery-grid">{gallery.map(([title,src],i)=><button className={`gallery-item reveal g${i+1}`} key={title} onClick={()=>setLightbox(src)}><img src={src} alt={`${title} — MM Motors placeholder`} loading="lazy"/><span>{title}<ArrowUpRight size={15}/></span></button>)}</div></section>
    <section id="why-us" className="section why"><div className="section-tag reveal">05 / WHY MM</div><div className="why-grid"><div className="reveal"><h2>Workshop<br/><em>without</em><br/>the guesswork.</h2></div><div className="why-list">{[['01','EXPERT TECHNICIANS','Hands-on experience across service, repair, detailing and modifications.',Wrench],['02','MODERN EQUIPMENT','A workshop environment designed around accurate diagnosis and clean execution.',Zap],['03','TRANSPARENT PRICING','Clear scopes, clear communication and no surprise additions.',ShieldCheck],['04','QUICK TURNAROUND','Efficient workflows that respect your time without rushing the work.',Clock3]].map(([n,t,c,Icon])=><div className="why-row reveal" key={n}><b>{n}</b><Icon size={22}/><div><h3>{t}</h3><p>{c}</p></div></div>)}</div></div></section>
    <section className="section testimonials"><div className="section-head reveal"><div><div className="section-tag">06 / DRIVER STORIES</div><h2>Good work gets <em>noticed.</em></h2></div><div className="carousel-controls"><button onClick={()=>setSlide((slide+2)%3)}><ChevronLeft/></button><button onClick={()=>setSlide((slide+1)%3)}><ChevronRight/></button></div></div><div className="quote-stage"><AnimatePresence mode="wait"><motion.div key={slide} initial={{opacity:0,x:50}} animate={{opacity:1,x:0}} exit={{opacity:0,x:-50}} className="quote-card"><Star/><blockquote>{testimonials[slide][0]}</blockquote><div><b>{testimonials[slide][1]}</b><span>{testimonials[slide][2]}</span></div></motion.div></AnimatePresence></div></section>
    <section className="section before-after"><div className="section-head reveal"><div><div className="section-tag">07 / DETAILING</div><h2>Before. After.<br/><em>One standard.</em></h2></div><p>Drag the divider to preview the kind of finish the studio is built to deliver.</p></div><div className="ba-wrap reveal"><img src="https://images.unsplash.com/photo-1607860108855-64acf2078ed9?auto=format&fit=crop&w=1800&q=85" alt="After detailing placeholder"/><div className="ba-before" style={{width:`${before}%`}}><img src="https://images.unsplash.com/photo-1487754180451-c456f719a1fc?auto=format&fit=crop&w=1800&q=85" alt="Before detailing placeholder"/></div><input aria-label="Before after comparison" type="range" min="0" max="100" value={before} onChange={e=>setBefore(e.target.value)}/><div className="ba-handle" style={{left:`${before}%`}}><span>↔</span></div><div className="ba-label before-label">BEFORE</div><div className="ba-label after-label">AFTER</div></div></section>
    <section id="booking" className="section booking"><div className="booking-intro reveal"><div className="section-tag">08 / YOUR NEXT DRIVE</div><h2>Let's get your<br/><em>car right.</em></h2><p>Tell us what your car needs. Our team can take it from first diagnosis to final delivery.</p><a className="whatsapp" href={`https://wa.me/${BRAND.whatsapp}`} target="_blank" rel="noreferrer"><MessageCircle/> CHAT ON WHATSAPP</a></div><form className="booking-form reveal" onSubmit={submit}><div className="form-grid"><label>Name<input required placeholder="Your name"/></label><label>Phone<input required type="tel" placeholder="+91 XXXXX XXXXX"/></label><label>Car model<input placeholder="e.g. Honda City"/></label><label>Service<select defaultValue=""><option value="" disabled>Select service</option>{services.map(s=><option key={s.title}>{s.title}</option>)}</select></label><label>Preferred date<input type="date"/></label><label>Preferred time<select defaultValue=""><option value="">Select time</option><option>10:00 AM</option><option>12:00 PM</option><option>3:00 PM</option><option>5:00 PM</option></select></label></div><label>What does your car need?<textarea rows="4" placeholder="Tell us briefly about the issue or upgrade..."/></label><button className="submit" type="submit">REQUEST A CALLBACK <ArrowUpRight size={18}/></button></form></section>
    <section id="contact" className="section contact"><div className="contact-grid"><div className="reveal"><div className="section-tag">09 / FIND MM MOTORS</div><h2>See you<br/><em>at the shop.</em></h2><div className="contact-items"><p><MapPin/><span><b>Lucknow, Uttar Pradesh</b><small>Exact branch address — replace placeholder</small></span></p><p><Clock3/><span><b>Mon — Sun / 10:00 AM — 8:00 PM</b><small>Hours may vary on public holidays</small></span></p><p><Phone/><span><b>{BRAND.phone}</b><small>Call / WhatsApp for appointments</small></span></p></div><div className="socials"><a href={BRAND.instagram} target="_blank" rel="noreferrer"><Instagram/> Instagram</a><a href={BRAND.youtube} target="_blank" rel="noreferrer"><Youtube/> YouTube</a></div></div><div className="map-card reveal"><div className="map-grid"/><div className="map-pin"><MapPin/><span>MM MOTORS<br/><small>LUCKNOW</small></span></div><div className="map-note">MAP PLACEHOLDER<br/><small>Embed your Google Maps iframe here.</small></div></div></div></section>
  </main><footer><div className="footer-brand"><span className="brand-mm">MM</span><div><b>MM MOTORS</b><small>REPAIR • MODIFY • UPGRADE</small></div></div><div className="footer-links"><a href="#home">Home</a><a href="#services">Services</a><a href="#gallery">Gallery</a><a href="#booking">Book</a></div><span>© {new Date().getFullYear()} MM Motors. Built for your drive.</span></footer>
  {lightbox&&<div className="lightbox" onClick={()=>setLightbox(null)}><button><X/></button><img src={lightbox} alt="MM Motors gallery preview"/></div>}
  </div>
}
createRoot(document.getElementById('root')).render(<App/>);
